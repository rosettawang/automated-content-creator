# Copy this file to .env and fill in your real values.
# .env is gitignored -- never commit it.

ANTHROPIC_API_KEY=sk-ant-...

# --- Social publishing (optional; only needed to post to real accounts) ---

# Composio API key. Adapters make all their platform calls through Composio.
COMPOSIO_API_KEY=

# Real-posting kill switch. Default (unset or =1) routes every publish through the
# dry-run adapter -- nothing is posted. Set to 0 ONLY when you intend to post for real
# (and the campaign is armed). Keep it at 1 until you've verified a platform end-to-end.
SOCIAL_DRY_RUN=1

# Instagram Business account id (the long numeric id, NOT the Composio 'ca_...' ref).
# Required to publish to Instagram: for the current Composio version the id isn't in
# the connection metadata, so paste it here once. Find it in Meta Business Suite, or via
# the Graph API Explorer with a user token (pages_show_list + instagram_basic):
#   me/accounts?fields=instagram_business_account{id,username}
IG_USER_ID=
